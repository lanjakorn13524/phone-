# ---- Supabase (จาก .env.local ที่สร้างจาก supabase link) ----
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role ห้ามเปิดเผยใน browser — ใช้เฉพาะ Edge Function / CI
SUPABASE_SERVICE_ROLE_KEY=
# connection string สำหรับ pg_dump ใน GitHub Actions (Settings > Database > URI, password เข้ารหัส URL)
DATABASE_URL=

# ---- เว็บย่อย (Firestore) : service account ของแต่ละเว็บ เก็บใน Supabase Vault เท่านั้น ----
# รูปแบบ JSON: { "type": "service_account", "project_id": "...", "client_email": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n..." }
FIREBASE_SITE_1_SERVICE_ACCOUNT=

# ---- AI (ฟรี) ----
CF_ACCOUNT_ID=
CF_API_TOKEN=
GEMINI_API_KEY=
